Q. Given a sorted array and a value x, the floor of x is the largest element in array smaller than or equal to x. Write divide and conquer algorithm to find floor of x.

Input Format:
   First Line Contains Integer n – Size of array
   Next n lines Contains n numbers – Elements of an array
   Last Line Contains Integer x – Value for x
 
Output Format:
   First Line Contains Integer – Floor value for x

CODE:

#include <stdio.h>
#include <stdlib.h>

int findFloor(int* arr, int n, int x) {
    int low = 0, high = n - 1;
    int floor = -1;
    
    while (low <= high) {
        int mid = low + (high - low) / 2;
        
        if (arr[mid] == x) {
            return arr[mid];
        } else if (arr[mid] < x) {
            floor = arr[mid];
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    
    return floor;
}

int main() {
    int n;
    if (scanf("%d", &n) == 1) {
        int* arr = (int*)malloc(n * sizeof(int));
        
        for (int i = 0; i < n; i++) {
            scanf("%d", &arr[i]);
        }
        
        int x;
        scanf("%d", &x);
        
        int result = findFloor(arr, n, x);
        printf("%d\n", result);
        
        free(arr);
    }
    
    return 0;
}
