Q. Given an array A of sorted integers and another non negative integer k, find if there exists 2 indices i and j such that A[j] - A[i] = k, i != j.

Input Format:
First Line n - Number of elements in an array
Next n Lines - N elements in the array
k - Non - Negative Integer

Output Format:
1 - If pair exists
0 - If no pair exists

Explanation for the given Sample Testcase:
YES as 5 - 1 = 4
So Return 1.

CODE:

#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, k;

    scanf("%d", &n);

    int a[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &k);

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            int diff = abs(a[i] - a[j]);

            if (diff == k) {
                printf("1");
                return 0;
            }
        }
    }

    printf("0");

    return 0;
}
