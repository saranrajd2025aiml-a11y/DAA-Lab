Q. Find Duplicate in Array.
Given a read only array of n integers between 1 and n, find one number that repeats.

Input Format:
First Line - Number of elements
n Lines - n Elements

Output Format:
Element x - That is repeated

CODE:

#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int a[n + 1];

    for (int i = 0; i <= n; i++) {
        a[i] = 0;
    }

    for (int i = 0; i < n; i++) {
        int x;
        scanf("%d", &x);

        if (a[x] == 1) {
            printf("%d", x);
            return 0;
        }

        a[x] = 1;
    }

    return 0;
}
