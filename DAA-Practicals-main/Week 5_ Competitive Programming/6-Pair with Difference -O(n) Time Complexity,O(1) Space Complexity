Q. Given an array A of sorted integers and another non negative integer k, find if there exists 2 indices i and j such that A[j] - A[i] = k, i != j.

Input Format:
First Line n - Number of elements in an array
Next n Lines - N elements in the array
k - Non - Negative Integer

Output Format:
1 - If pair exists
0 - If no pair exists

Explanation for the given Sample Testcase:
YES as 5 - 1 = 4
So Return 1.

CODE:

#include <stdio.h>

int main() {
    int n, k;

    scanf("%d", &n);

    int a[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    scanf("%d", &k);

    int i = 0;
    int j = 1;

    while (i < n && j < n) {

        if (i == j) {
            j++;
        }
        else if (a[j] - a[i] == k) {
            printf("1");
            return 0;
        }
        else if (a[j] - a[i] < k) {
            j++;
        }
        else {
            i++;
        }
    }

    printf("0");

    return 0;
}
