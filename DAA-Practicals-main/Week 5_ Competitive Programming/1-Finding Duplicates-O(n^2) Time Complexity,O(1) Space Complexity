Q. Find Duplicate in Array.
Given a read only array of n integers between 1 and n, find one number that repeats.

Input Format:
First Line - Number of elements
n Lines - n Elements

Output Format:
Element x - That is repeated

CODE:

#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int count[n + 1];

    // Initialize count array
    for (int i = 0; i <= n; i++) {
        count[i] = 0;
    }

    // Read elements and find duplicate
    for (int i = 0; i < n; i++) {
        int x;
        scanf("%d", &x);

        count[x]++;

        if (count[x] == 2) {
            printf("%d", x);
            return 0;
        }
    }

    return 0;
}
